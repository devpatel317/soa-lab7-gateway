		{
			"name": "3. Order Service (:3003)",
			"item": [
				{
					"name": "Create Order (Valid - Inter-Service Validation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set('orderId', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"productId\": \"{{productId}}\",\n    \"quantity\": 2\n}"
						},
						"url": {
							"raw": "{{order_url}}/orders",
							"host": ["{{order_url}}"],
							"path": ["orders"]
						},
						"description": "Calls User Service (:3001) and Product Service (:3002) to validate IDs, checks stock, calculates totalPrice, and records the order (201 Created)."
					}
				},
				{
					"name": "Get All Orders",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{order_url}}/orders",
							"host": ["{{order_url}}"],
							"path": ["orders"]
						},
						"description": "Retrieves all placed orders (200 OK)."
					}
				},
				{
					"name": "Get Order By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{order_url}}/orders/{{orderId}}",
							"host": ["{{order_url}}"],
							"path": ["orders", "{{orderId}}"]
						},
						"description": "Retrieves order details by unique order ID."
					}
				},
				{
					"name": "Create Order - Invalid User ID (404 Test)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"65e900000000000000000000\",\n    \"productId\": \"{{productId}}\",\n    \"quantity\": 1\n}"
						},
						"url": {
							"raw": "{{order_url}}/orders",
							"host": ["{{order_url}}"],
							"path": ["orders"]
						},
						"description": "Tests Order Service behavior when User Service responds with 404 (Returns 404 Not Found)."
					}
				},
				{
					"name": "Create Order - Invalid Product ID (404 Test)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"productId\": \"65e900000000000000000000\",\n    \"quantity\": 1\n}"
						},
						"url": {
							"raw": "{{order_url}}/orders",
							"host": ["{{order_url}}"],
							"path": ["orders"]
						},
						"description": "Tests Order Service behavior when Product Service responds with 404 (Returns 404 Not Found)."
					}
				},
				{
					"name": "Create Order - Service Unavailable (503 Test)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": \"{{userId}}\",\n    \"productId\": \"{{productId}}\",\n    \"quantity\": 1\n}"
						},
						"url": {
							"raw": "{{order_url}}/orders",
							"host": ["{{order_url}}"],
							"path": ["orders"]
						},
						"description": "Demonstrates controlled 503 error handling when User Service or Product Service container is stopped."
					}
				}
			]
