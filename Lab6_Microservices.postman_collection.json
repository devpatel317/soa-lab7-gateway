	"item": [
		{
			"name": "1. User Service (:3001)",
			"item": [
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{user_url}}/users",
							"host": ["{{user_url}}"],
							"path": ["users"]
						},
						"description": "Returns a list of all registered users (200 OK)."
					}
				},
				{
					"name": "Create User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set('userId', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Alice Johnson\",\n    \"email\": \"alice@example.com\",\n    \"phone\": \"+1-555-0199\",\n    \"address\": \"123 Innovation Way, Tech City\"\n}"
						},
						"url": {
							"raw": "{{user_url}}/users",
							"host": ["{{user_url}}"],
							"path": ["users"]
						},
						"description": "Creates a new user in User Service MongoDB (201 Created)."
					}
				},
				{
					"name": "Get User By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{user_url}}/users/{{userId}}",
							"host": ["{{user_url}}"],
							"path": ["users", "{{userId}}"]
						},
						"description": "Retrieves user details by their unique MongoDB ID."
					}
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"+1-555-9999\",\n    \"address\": \"456 Commerce Blvd, Suite 200\"\n}"
						},
						"url": {
							"raw": "{{user_url}}/users/{{userId}}",
							"host": ["{{user_url}}"],
							"path": ["users", "{{userId}}"]
						},
						"description": "Updates user details (200 OK)."
					}
				},
				{
					"name": "Get User - Invalid ID (404 Test)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{user_url}}/users/65e900000000000000000000",
							"host": ["{{user_url}}"],
							"path": ["users", "65e900000000000000000000"]
						},
						"description": "Tests 404 Not Found error handling for non-existent user."
					}
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{user_url}}/users/{{userId}}",
							"host": ["{{user_url}}"],
							"path": ["users", "{{userId}}"]
						},
						"description": "Deletes user by ID (200 OK)."
					}
				}
			]
		},
		{
