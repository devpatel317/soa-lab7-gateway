# =============================================================
# SOA LAB 7 - ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================

# Common MongoDB Atlas URI (if sharing one cluster or DB instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/microservices_db?retryWrites=true&w=majority

# Or Specific MongoDB Atlas URIs per microservice (Recommended for isolation)
USER_MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/userdb?retryWrites=true&w=majority
PRODUCT_MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/productdb?retryWrites=true&w=majority
ORDER_MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/orderdb?retryWrites=true&w=majority

# API Gateway Configuration
PORT=8080
PROXY_TIMEOUT_MS=10000

# Service Discovery URLs for API Gateway
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Inter-Service Communication Timeout for Order Service
HTTP_TIMEOUT_MS=5000
